# ===== Panel =====
PANEL_PORT=8080
# Bind the panel to 127.0.0.1 if you only reach it through an SSH tunnel / reverse proxy.
PANEL_HOST=0.0.0.0
ADMIN_USER=admin
# Leave empty to auto-generate (saved to data/admin_password.txt and printed in the logs).
ADMIN_PASSWORD=
SESSION_TTL_HOURS=24

# Public IP or domain of the server, used to build the proxy URLs shown in the panel.
PUBLIC_HOST=

# ===== Proxies =====
PROXY_BIND_HOST=0.0.0.0
# New / rotated proxies get a random free port from this range. Open it in your firewall.
PROXY_PORT_MIN=20000
PROXY_PORT_MAX=29999
UPSTREAM_TIMEOUT_MS=60000
# Verify the real server's certificate when decrypting HTTPS (MITM). Set false for self-signed targets.
MITM_VERIFY_UPSTREAM=true

# ===== Traffic log =====
# Max bytes stored per request body and per response body.
CAPTURE_MAX_BODY=524288
LOG_MAX_ROWS=50000
LOG_RETENTION_HOURS=72
